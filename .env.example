# Postgres connection string for the Raspberry Pi DB (or tunneled host).
# e.g. postgresql://navisense:PASSWORD@navisense-db.example.com:5433/navisense
SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# SMTP (demo request emails)
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=no-reply@arl-navisense.com
SMTP_PASSWORD=your-smtp-password
ADMIN_EMAILS=nik.amirul@arlsb.com,zulkifli@arlsb.com

# API key required by the SIM900 ingest endpoint
INGEST_API_KEY=generate-a-long-random-key
