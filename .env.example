# Primary cloud database (Supabase).
# Use the transaction-mode pooler, port 6543.
SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Optional mirror: PostgreSQL on the Raspberry Pi, reached through a
# Cloudflare Tunnel. When set, all writes are mirrored to this DB.
# e.g. postgresql://navisense:PASSWORD@pi-db.yourdomain.com:5432/navisense
PI_DATABASE_URL=

# SMTP (demo request emails)
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=no-reply@arl-navisense.com
SMTP_PASSWORD=your-smtp-password
ADMIN_EMAILS=nik.amirul@arlsb.com,zulkifli@arlsb.com

# API key required by the SIM900 ingest endpoint
INGEST_API_KEY=generate-a-long-random-key
